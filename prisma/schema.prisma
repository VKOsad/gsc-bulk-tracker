generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Cached Bing/Yandex portfolio snapshots. Live engine APIs are slow for large site lists,
// so the dashboard stores the last computed result per user+engine+period and only rebuilds
// it on demand (Sync / Refresh). This makes engine tabs open instantly after the first build.
model EnginePortfolioCache {
  id        String   @id @default(cuid())
  userId    String
  engine    String // "bing" | "yandex"
  period    String
  data      String // JSON: array of per-site portfolio payloads
  updatedAt DateTime @updatedAt

  @@unique([userId, engine, period])
  @@index([userId])
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  sites         Site[]

  // SEO Tools settings backup (JSON snapshot of the browser-side keys/preferences), so
  // clearing the browser storage doesn't lose configured API keys. Accessed via raw SQL.
  seoSettings String?

  // MCP access token (Bearer) for the /api/mcp endpoint — lets AI agents (Claude Code,
  // Cursor, etc.) query this user's SEO data. Generated in Settings → API & MCP.
  mcpToken String? @unique

  // Notifications: user-owned Telegram bot (BotFather token + detected chat id) and
  // JSON settings for the alert rules / digest schedule. Accessed via raw SQL (same
  // graceful-degradation convention as seoSettings).
  telegramBotToken String?
  telegramChatId   String?
  slackWebhook     String? // Slack Incoming Webhook URL — optional second delivery channel
  alertSettings    String? // JSON: { rankDrop: {on,threshold}, trafficDrop: {on,percent}, ssl: {on,days}, audit: {on,minScore} }
  digestSettings   String? // JSON: { enabled, frequency: "daily"|"weekly", hourUtc, tag, days, ai, lastSentAt }

  // Third-party API integrations
  neuralIndexerToken String?
  xmlRiverUserId     String?
  xmlRiverApiKey     String?
  twoIndexToken      String?

  // Custom Indexer Bot Farm
  indexerDomains      IndexerDomain[]
  indexerDictionaries IndexerDictionary[]

  // SEO Tools background generation jobs
  seoJobs SeoJob[]

  // GEO Audits (how AI search engines perceive the brand/niche)
  geoAudits GeoAudit[]

  // Rank Tracker — Topvisor project-based rank tracking (see schema tail)
  topvisorConnection TopvisorConnection?
  rankJobs           RankJob[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Site {
  id              String   @id @default(cuid())
  userId          String
  url             String
  siteId          String // GSC property root (sc-domain: or url)
  tags            String? // JSON array string or comma separated
  brandedKeywords String? // JSON array e.g. ["ikea","ikea chair"]
  createdAt       DateTime @default(now())

  // Sitemap indexing
  sitemapUrl      String? // custom sitemap URL (defaults to url + /sitemap.xml)
  crawlInterval   String? // "disabled" | "daily" | "weekly" | "monthly"
  lastSitemapSync DateTime?

  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics                 DailyMetric[]
  contentGroups           ContentGroup[]
  topicClusters           TopicCluster[]
  pageInspections         PageInspection[]
  pageInspectionHistories PageInspectionHistory[]
  siteHealth              SiteHealth?
  sitemapUrls             SitemapUrl[]
  indexingOperations      IndexingOperation[]
  backlinks               Backlink[]
  siteAudits              SiteAudit[]
  claritySnapshots        ClaritySnapshot[]
  trackedKeywords         TrackedKeyword[]
  trackedQuestions        TrackedQuestion[]
  rankProjects            RankProject[]

  // Microsoft Clarity integration
  clarityToken     String? // Data Export API token (per-project in Clarity)
  clarityProjectId String? // Clarity project ID (shown in Clarity dashboard URL)
  clarityInterval  String? // auto-collect cadence: "disabled" | "daily"

  // Google Analytics 4 integration
  ga4PropertyId   String? // GA4 numeric property ID (e.g. "123456789")
  ga4PropertyName String? // GA4 property display name (cached for UI)

  // Client read-only share settings
  shareEnabled Boolean @default(false)
  shareToken   String? @unique

  @@unique([userId, siteId])
}

model SitemapUrl {
  id     String @id @default(cuid())
  siteId String
  url    String

  // Google URL Inspection status
  googleStatus   String? // "Submitted and indexed", "URL is not on Google", etc.
  googleCoverage String? // raw coverage state
  googleReason   String?
  googleChecked  DateTime?

  // XML River check
  xrStatus  String? // "indexed" | "not_indexed" | "error"
  xrChecked DateTime?

  // 2index.ninja submission
  twoIndexStatus String? // "submitted" | "not_submitted"
  twoIndexAt     DateTime?

  // NeuralIndexer submission
  neuralStatus String? // "submitted"
  neuralAt     DateTime?
  neuralQueue  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, url])
  @@index([siteId])
}

model Backlink {
  id             String    @id @default(cuid())
  siteId         String
  url            String // the backlink URL (page that links to us)
  title          String? // page title from 404-check crawl
  isAlive        Boolean? // null = not checked; true = alive; false = dead/404
  aliveChecked   DateTime?
  xrStatus       String? // "indexed" | "not_indexed" | "error"
  xrChecked      DateTime?
  twoIndexStatus String? // "submitted"
  twoIndexAt     DateTime?
  addedAt        DateTime  @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, url])
  @@index([siteId])
}

model IndexingOperation {
  id        String   @id @default(cuid())
  siteId    String
  urlCount  Int? // how many URLs were affected
  type      String // "sitemap_sync" | "google_check" | "xr_check" | "2index_submit" | "neural_submit"
  result    String? // "success" | "error" | "partial"
  detail    String? // JSON or text with extra info
  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
}

model DailyMetric {
  id          String   @id @default(cuid())
  siteId      String
  date        DateTime
  url         String
  query       String
  clicks      Int
  impressions Int
  ctr         Float
  position    Float

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, date])
  @@index([url])
  @@index([query])
}

// ─── Rank Tracker (SERP position monitoring) ─────────────────────────────────
// Tracked keywords are checked daily by the in-app scheduler (rankScheduler) via the
// user's configured SERP provider (Serper.dev / DataForSEO — same keys as SEO Tools).
model TrackedKeyword {
  id            String    @id @default(cuid())
  siteId        String
  keyword       String
  device        String    @default("desktop") // reserved: "desktop" | "mobile"
  country       String    @default("us") // gl code (2-letter)
  lang          String    @default("en") // hl code
  createdAt     DateTime  @default(now())
  lastCheckedAt DateTime?

  // Denormalized latest state for cheap list rendering.
  // For Topvisor keywords these mirror the PRIMARY region so the existing
  // rank-drop alerts (alertScheduler, which reads lastPosition/prevPosition) keep working.
  lastPosition Int? // null = not found in scanned depth
  prevPosition Int? // position from the previous check
  bestPosition Int?
  lastUrl      String? // ranking URL found on the last check

  // ── Topvisor project-based tracking (provider-neutral; all nullable = non-breaking) ──
  provider          String    @default("serp") // "serp" (legacy SERP providers) | "topvisor"
  rankProjectId     String? // FK to RankProject when provider = "topvisor"
  externalKeywordId String? // Topvisor keyword id
  externalGroupId   String? // Topvisor group id
  externalGroupName String? // Topvisor group name (default "Основная")
  active            Boolean   @default(true)
  lastRemoteSyncAt  DateTime?

  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  rankProject RankProject? @relation(fields: [rankProjectId], references: [id], onDelete: Cascade)
  checks      RankCheck[]

  // provider added to the legacy unique so a Topvisor phrase never collides with a
  // legacy "serp" phrase on the same site (and vice-versa). Legacy rows are always "serp".
  @@unique([siteId, keyword, device, country, provider])
  // Topvisor phrases are unique per project (rankProjectId null for legacy → NULLs distinct).
  @@unique([rankProjectId, keyword])
  @@index([siteId])
  @@index([lastCheckedAt])
  @@index([rankProjectId])
  @@index([externalKeywordId])
}

// ─── Notifications (alerts + digests, delivered via the user's Telegram bot) ──
model AlertEvent {
  id        String   @id @default(cuid())
  userId    String
  type      String // "rank_drop" | "traffic_drop" | "ssl_expiry" | "audit_score"
  siteId    String?
  title     String
  message   String
  dedupeKey String // stable key per logical event occurrence — prevents repeat alerts
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
}

model Digest {
  id        String   @id @default(cuid())
  userId    String
  tag       String   @default("") // empty = all sites
  days      Int      @default(7)
  content   String // rendered Markdown
  sentTo    String? // "telegram" when delivered, null for on-screen only
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── Site Audit (built-in crawler — no external APIs) ────────────────────────
// One row per audit run. The crawler BFS-walks same-host pages from the site root,
// extracts on-page SEO signals with no headless browser (plain fetch + HTML parsing),
// and stores per-page results in SiteAuditPage. Fire-and-forget job, same pattern
// as SeoJob (§1 of docs/ARCHITECTURE.md).
model SiteAudit {
  id           String    @id @default(cuid())
  siteId       String
  status       String    @default("running") // "running" | "completed" | "error"
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  maxPages     Int       @default(200)
  pagesCrawled Int       @default(0)
  summary      String? // JSON: issue counts, totals
  error        String?

  site  Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  pages SiteAuditPage[]

  @@index([siteId, startedAt])
}

model SiteAuditPage {
  id              String  @id @default(cuid())
  auditId         String
  url             String
  httpStatus      Int     @default(0) // 0 = fetch failed
  redirectTo      String?
  contentType     String  @default("")
  title           String  @default("")
  metaDescription String  @default("")
  h1Count         Int     @default(0)
  canonical       String?
  noindex         Boolean @default(false)
  internalLinks   Int     @default(0)
  externalLinks   Int     @default(0)
  imagesNoAlt     Int     @default(0)
  wordCount       Int     @default(0)
  loadMs          Int     @default(0)
  depth           Int     @default(0)
  issues          String? // JSON array of issue codes, e.g. ["title_missing","broken_links"]
  brokenLinks     String? // JSON array of hrefs on this page that resolved 4xx/5xx

  audit SiteAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
}

model RankCheck {
  id        String   @id @default(cuid())
  keywordId String
  checkedAt DateTime @default(now())
  position  Int? // null = not found
  url       String?
  depth     Int? // how many results were scanned
  error     String?

  // ── Topvisor multi-region results (nullable = non-breaking) ──
  // A keyword can have parallel rows per region/device — rankRegionId keeps them
  // separate so one region's result never overwrites another's.
  source            String    @default("serp") // "serp" | "topvisor"
  rankRegionId      String?
  externalCheckedAt DateTime? // the actual Topvisor check date (may differ from checkedAt)
  snippet           String?
  serpFeatures      String? // JSON (only when the API returns serp_features)
  syncedAt          DateTime?

  keyword TrackedKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  region  RankRegion?    @relation(fields: [rankRegionId], references: [id], onDelete: SetNull)

  @@index([keywordId, checkedAt])
  @@index([rankRegionId, checkedAt])
}

// ─── AEO Tracker (AI answer-engine citation monitoring) ──────────────────────
// Tracked questions are checked periodically by the in-app scheduler (aeoScheduler) across
// multiple AI engines (ChatGPT, Perplexity, Claude, Grok) — same in-app-cron pattern as
// clarityScheduler/rankScheduler, no system cron needed. ChatGPT/Perplexity use live web
// search (a citation URL matching the site's domain is the strongest signal); Claude/Grok
// have no guaranteed browsing, so they fall back to text-mention matching.
model TrackedQuestion {
  id            String    @id @default(cuid())
  siteId        String
  question      String
  createdAt     DateTime  @default(now())
  lastCheckedAt DateTime?

  // Denormalized latest per-engine state for cheap list rendering — JSON:
  // { chatgpt: { cited, url, checkedAt }, perplexity: {...}, claude: {...}, grok: {...} }
  lastResults String?

  site   Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  checks AeoCheck[]

  @@unique([siteId, question])
  @@index([siteId])
  @@index([lastCheckedAt])
}

model AeoCheck {
  id         String   @id @default(cuid())
  questionId String
  engine     String // "chatgpt" | "perplexity" | "claude" | "grok"
  checkedAt  DateTime @default(now())
  cited      Boolean
  url        String?
  snippet    String?
  error      String?

  question TrackedQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, checkedAt])
}

model ContentGroup {
  id        String   @id @default(cuid())
  siteId    String
  name      String
  rules     String // JSON: [{type:"contains"|"equals", values:string[]}]
  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model TopicCluster {
  id        String   @id @default(cuid())
  siteId    String
  name      String
  rules     String // JSON: [{type:"contains"|"equals", values:string[]}]
  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model PageInspection {
  id          String    @id @default(cuid())
  siteId      String
  url         String
  status      String // e.g. "Submitted and indexed"
  lastCrawl   DateTime?
  richResults String?
  lastInspect DateTime  @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, url])
}

model PageInspectionHistory {
  id     String   @id @default(cuid())
  siteId String
  url    String
  date   DateTime
  status String

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, url, date])
}

// Microsoft Clarity — cached daily snapshots (API limit: 10 req/day, 3 days max)
model ClaritySnapshot {
  id         String   @id @default(cuid())
  siteId     String
  fetchedAt  DateTime @default(now())
  periodDays Int // 1, 2, or 3 — numOfDays sent to API
  data       String // raw JSON from Clarity API

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, fetchedAt])
}

model SiteHealth {
  id           String   @id @default(cuid())
  siteId       String   @unique
  checkedAt    DateTime @default(now())
  sslData      String? // JSON: { valid, daysLeft, issuer, grade, error? }
  safeBrowsing String? // JSON: { safe, threats?, error? }
  vitals       String? // JSON: { lcp, fid, cls, ttfb, score, error? }
  virusTotal   String? // JSON: { clean, malicious, suspicious, error? }

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

// ─── Custom Indexer Bot Farm Models ──────────────────────────────────────────

model IndexerDomain {
  id              String   @id @default(cuid())
  userId          String
  domain          String
  status          String   @default("active") // "active", "inactive", "expired"
  createdAt       DateTime @default(now())
  apiKey          String   @default(cuid())
  template        String   @default("ecommerce")
  moneyUrl        String?
  allowedBots     String   @default("google,bing,yandex,mailru,ai")
  pagesCount      Int      @default(0)
  subdomainsCount Int      @default(0)

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs  IndexerLog[]
  queue IndexerQueue[]

  @@unique([userId, domain])
}

model IndexerLog {
  id         String   @id @default(cuid())
  domainId   String
  timestamp  DateTime @default(now())
  url        String
  ip         String
  userAgent  String
  botType    String // "google", "bing", "yandex", "other", "redirect"
  statusCode Int      @default(200)
  referer    String?

  domain IndexerDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId, timestamp])
}

model IndexerQueue {
  id        String    @id @default(cuid())
  domainId  String
  url       String
  status    String    @default("pending") // "pending", "crawled", "indexed"
  createdAt DateTime  @default(now())
  crawledAt DateTime?

  domain IndexerDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, url])
}

model IndexerDictionary {
  id        String   @id @default(cuid())
  userId    String
  word      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, word])
}

// ─── SEO Tools — background generation jobs (outline / text / analysis) ──────────
// Lets a generation run server-side and persist its result, so the user can close
// the tab and pick the finished task up later from History.
model SeoJob {
  id        String   @id @default(cuid())
  userId    String
  type      String // "outline" | "text" | "analysis" | "landing"
  keyword   String   @default("")
  status    String   @default("processing") // "processing" | "completed" | "error"
  result    String? // JSON string of the result (outline object / { text, ... } / report)
  error     String?
  meta      String? // JSON string (tone, promptType, outlineId, factcheck/images flags…)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─── SEO Tools knowledge base (Casino RAG) ─────────────────────────────────────
// Structured entity facts (slots, casinos) injected into outline/text generation.
// Populated by scripts/import-rag.ts from CSV exports; matched by normalized name.
model RagSlot {
  id         String @id @default(cuid())
  name       String
  nameNorm   String // lowercase, trimmed — for keyword containment matching
  provider   String @default("")
  released   String @default("") // release date/year as text (source formats vary)
  slotType   String @default("") // "Видео слоты" / genre
  rtp        String @default("")
  volatility String @default("")
  maxWin     String @default("")
  minBet     String @default("")
  maxBet     String @default("")
  layout     String @default("") // e.g. "5-3" reels x rows
  lines      String @default("")
  features   String @default("") // comma-separated feature list
  themes     String @default("")
  demoUrl    String @default("")
  platform   String @default("")
  source     String @default("") // "35k" | "demo"

  @@index([nameNorm])
  @@index([provider])
}

// Cached Ahrefs Domain Rating (free public API, 7-day TTL). Attribution required in UI:
// "Domain Rating by Ahrefs" → https://ahrefs.com/ (see ahrefs.com/legal/domain-rating-license).
// Server-side copy of the SEO Tools generation history (outlines/texts/analyses).
// The browser's localStorage stays the working cache; this table survives browser resets.
model SeoHistory {
  id        String   @id // client-generated history id
  userId    String
  type      String
  keyword   String   @default("")
  status    String   @default("completed")
  data      String // JSON payload (outline object / article markdown)
  meta      String? // JSON meta
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model DrCache {
  domain    String   @id
  dr        Float
  checkedAt DateTime @default(now())
}

// ─── Link Monitor (Ahrefs API v3) — track fresh quality backlinks to watched brands ──
model LinkWatchBrand {
  id        String   @id @default(cuid())
  userId    String
  domain    String
  createdAt DateTime @default(now())

  @@unique([userId, domain])
}

model LinkMention {
  id         String   @id @default(cuid())
  userId     String
  brand      String // watched brand domain
  urlFrom    String
  domainFrom String
  title      String   @default("")
  anchor     String   @default("")
  drFrom     Float    @default(0)
  firstSeen  String   @default("")
  urlTo      String   @default("")
  dofollow   Boolean  @default(true)
  fetchedAt  DateTime @default(now())

  @@index([userId, brand])
  @@index([userId, domainFrom])
}

model RagCasino {
  id          String @id @default(cuid())
  name        String
  nameNorm    String
  website     String @default("")
  country     String @default("")
  founded     String @default("")
  locality    String @default("")
  region      String @default("")
  size        String @default("")
  linkedinUrl String @default("")
  source      String @default("")

  @@index([nameNorm])
}

// ─── GEO Audit — how AI search engines (e.g. ChatGPT web search) perceive a niche ──
// A single run = one keyword/query analyzed with an agentic web-search model. We persist
// the raw search trace (batches, opened pages, citations) plus the derived analytics
// (brand leaderboard, trust signals, inclusion patterns) as one JSON `report`.
model GeoAudit {
  id        String   @id @default(cuid())
  userId    String
  query     String   @default("") // the keyword / search query that was audited
  language  String   @default("en")
  country   String   @default("us")
  model     String   @default("") // engine model used (e.g. "gpt-5")
  status    String   @default("processing") // "processing" | "completed" | "error"
  report    String? // JSON string: full audit report (metrics + analytics + raw answer)
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Rank Tracker — Topvisor project-based rank tracking.
// Topvisor is the source of truth for remote projects, regions, keywords,
// results, price and check status. Locally we store only the binding, settings,
// latest positions, and a TTL'd summary cache — never a full copy of all history.
// All new fields are additive/nullable so `prisma db push` applies them safely.
// ─────────────────────────────────────────────────────────────────────────────

// Encrypted Topvisor API credentials, one per user. The API key is AES-256-GCM
// encrypted with TOPVISOR_ENCRYPTION_KEY and only ever decrypted inside a
// server-side call — never returned to the browser, logged, or committed.
model TopvisorConnection {
  id              String    @id @default(cuid())
  userId          String    @unique
  apiUserId       String // Topvisor "User-Id" header value (not secret)
  encryptedApiKey String // AES-256-GCM ciphertext (base64)
  keyIv           String // base64 IV (12 bytes)
  keyAuthTag      String // base64 GCM auth tag (16 bytes)
  status          String    @default("unverified") // unverified | connected | error
  lastVerifiedAt  DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Binding of a local OpenGSC Site to a remote Topvisor project. Provider-neutral
// so another project-based provider can be added later.
model RankProject {
  id                   String    @id @default(cuid())
  siteId               String
  provider             String    @default("topvisor")
  externalProjectId    String? // Topvisor project id (null until created/linked)
  externalProjectName  String?
  normalizedDomain     String // canonical host used for dedupe
  status               String    @default("draft") // draft|partial|active|checking|syncing|error|disconnected
  autoCheckEnabled     Boolean   @default(false)
  scheduleType         String    @default("manual") // manual|daily|weekly
  scheduleTime         String? // "HH:MM" local
  scheduleTimezone     String?   @default("Europe/Warsaw")
  scheduleDays         String? // JSON array of weekday ints (0-6) for weekly
  costLimit            Float? // max allowed cost per scheduled run (account currency)
  favorite             Boolean   @default(false)
  lastRemoteSyncAt     DateTime?
  lastCheckRequestedAt DateTime?
  lastCheckCompletedAt DateTime?
  lastError            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  site      Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  regions   RankRegion[]
  keywords  TrackedKeyword[]
  jobs      RankJob[]
  summaries RankSummaryCache[]

  // One binding per site per provider (lifecycle handled via status transitions).
  @@unique([siteId, provider])
  @@index([siteId])
  @@index([provider, externalProjectId])
  @@index([status])
}

// A searcher+region+language+device+depth combination attached to a project.
// region_key is the input for ADDING a region; region_index is the input for
// history/price/check queries — both are stored (they are NOT interchangeable).
model RankRegion {
  id            String   @id @default(cuid())
  rankProjectId String
  searcherKey   Int      @default(1) // Google = 1
  regionKey     Int // Topvisor global region id (used to ADD the region)
  regionIndex   Int? // per-project searcher+region index (used to QUERY); set after re-fetch
  regionName    String?
  countryCode   String?
  language      String   @default("en")
  device        Int      @default(0) // 0 desktop | 1 tablet | 2 phone
  depth         Int      @default(5) // 1..5 (Google: 1=Top10 … 5=Top50, the default); Google Top-100 is not supported
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project RankProject @relation(fields: [rankProjectId], references: [id], onDelete: Cascade)
  checks  RankCheck[]

  @@unique([rankProjectId, regionKey, language, device])
  @@index([rankProjectId])
}

// Async operation tracking so paid checks run as background jobs, never inside an
// open HTTP request. Idempotency + double-click protection live at this layer.
model RankJob {
  id            String    @id @default(cuid())
  userId        String
  rankProjectId String?
  type          String // create_project|import_keywords|price|check|sync
  status        String    @default("queued") // queued|running|waiting_remote|completed|failed|cancelled
  progress      Int       @default(0) // 0..100
  remoteStatus  String? // Topvisor status_positions / percent snapshot
  estimatedCost Float?
  currency      String?
  payload       String? // JSON input (regions_indexes, groups_ids, filters…)
  result        String? // JSON output/summary
  errorCode     String?
  errorMessage  String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project RankProject? @relation(fields: [rankProjectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([rankProjectId, status])
  @@index([status])
}

// TTL'd cache of Topvisor summary / summary_chart payloads so the portfolio and
// project pages render from the local DB, not 500 live API calls.
model RankSummaryCache {
  id            String   @id @default(cuid())
  rankProjectId String
  rankRegionId  String?
  scope         String   @default("summary") // summary | chart
  dateFrom      String // ISO date
  dateTo        String // ISO date
  data          String // JSON payload from Topvisor
  expiresAt     DateTime
  updatedAt     DateTime @updatedAt

  project RankProject @relation(fields: [rankProjectId], references: [id], onDelete: Cascade)

  @@unique([rankProjectId, rankRegionId, scope, dateFrom, dateTo])
  @@index([rankProjectId])
  @@index([expiresAt])
}
