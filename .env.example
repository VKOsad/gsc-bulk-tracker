# ─────────────────────────────────────────────────────────────────────────────
# gsc-bulk-tracker (OpenGSC) — environment template
# Copy to .env and fill in real values:   cp .env.example .env
# NEVER commit .env — it is gitignored. Keep it chmod 600 on the server.
# See docs/DEPLOYMENT.md and docs/GOOGLE-OAUTH-SETUP.md for details.
# ─────────────────────────────────────────────────────────────────────────────

# Database. In Docker this is overridden to the named volume at /data/prod.db,
# so the SQLite file survives rebuilds/updates. Leave as-is for the Docker deploy.
DATABASE_URL="file:/data/prod.db"

# NextAuth session-encryption secret (REQUIRED).
# Generate a strong one:   openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Public URL of the app (REQUIRED). Must EXACTLY match the Google OAuth origin,
# including scheme. Example for this deployment:
NEXTAUTH_URL="https://gsc.example.com"

# Google OAuth 2.0 credentials (REQUIRED for login).
# Create them in Google Cloud Console — see docs/GOOGLE-OAUTH-SETUP.md.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Host port published on 127.0.0.1 (Nginx reverse-proxies to it). Default 3000.
PORT=3000

# Timezone.
TZ="Europe/Warsaw"

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL modules — NOT enabled for a basic GSC deployment. Leave blank/off.
# Enabling the AI keys turns on paid third-party features.
# ─────────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# GOOGLEBOT_PROXY=""
